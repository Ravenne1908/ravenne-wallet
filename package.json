{
  "name": "ravenne-wallet",
  "version": "9.10.0",
  "description": "Encrypted, 100% local terminal wallet — EVM chains, Bitcoin and Monero. No server, no telemetry.",
  "main": "ravenne.js",
  "bin": { "ravenne": "ravenne.js" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ravenne1908/ravenne-wallet.git"
  },
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node ravenne.js",
    "test": "node --test",
    "build": "build.bat",
    "icon": "node make-icon.mjs",
    "check": "node --check ravenne.js",
    "keygen": "node scripts/sign-release.mjs --init",
    "sign": "node scripts/sign-release.mjs",
    "verify-sign": "node scripts/verify-release.mjs"
  },
  "keywords": ["wallet", "crypto", "bitcoin", "ethereum", "monero", "terminal", "privacy"],
  "author": "ravennelucas1908-max",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@noble/hashes": "^1.3.2",
    "bitcoinjs-lib": "^7.0.5",
    "ethers": "^6.17.0",
    "monero-javascript": "^0.8.4",
    "prompts": "^2.4.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.25.0",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2"
  }
}
